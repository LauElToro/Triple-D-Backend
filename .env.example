# ---- Database ----
# Local: Postgres propio. Producción: Prisma Postgres / Vercel Postgres / Neon.
# Vercel: ver VERCEL.env.template.md
# DATABASE_URL es la única que consumen Prisma y la app; usar conexión DIRECTA
# (no pooler) para que `prisma migrate deploy` funcione en el build.
DATABASE_URL="postgresql://setapi:setapi@localhost:5432/setapi?schema=public"
# Opcionales: alias que setea la integración Prisma Postgres / Vercel.
POSTGRES_URL=""
PRISMA_DATABASE_URL=""

# ---- App URLs ----
API_URL="https://set-api-backend.vercel.app"
# Origen(es) del frontend permitidos por CORS (coma-separados).
WEB_APP_URL="https://www.set-api.com,https://set-api.com,https://set-api-web.vercel.app"

# ---- JWT / Sessions ----
JWT_ACCESS_SECRET="change-me-access-secret-32chars-min"
JWT_REFRESH_SECRET="change-me-refresh-secret-32chars-min"
ACCESS_TOKEN_TTL_SECONDS="7200"
REFRESH_TOKEN_TTL_SECONDS="1209600"

# ---- API Keys ----
API_KEY_PEPPER="change-me-api-key-pepper"

# ---- Google Sign-In (opcional) ----
# Dejar vacío si solo usás email/contraseña. Mismo Client ID en Frontend → VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=""

# ---- Gmail (nodemailer) ----
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
MAIL_FROM="Set-Api <no-reply@example.com>"

# ---- Didit KYC ----
DIDIT_API_KEY=""
DIDIT_WEBHOOK_SECRET=""
DIDIT_WORKFLOW_ID=""
DIDIT_BASE_URL="https://verification.didit.me"

# ---- ARCA gateway (FastAPI on Vercel) ----
# Local dev: http://localhost:3000 (SET_API_ARCA)
# Production: https://set-api-arca-three.vercel.app
ARCA_BASE_URL="https://set-api-arca-three.vercel.app"
# Must match SET_API_ARCA API_KEY (server-to-server only, never expose to clients)
ARCA_API_KEY="change-me-arca-gateway-key-min-24-chars"

# ---- Bootstrap SuperAdmin (seed) ----
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""

# ---- Estimated ARCA provider costs (ARS per unit) ----
# ARCA_COST_COMPROBANTES="2"
# ARCA_COST_CONSTATACIONES="1.5"
# ARCA_COST_PADRON="0.5"
# ARCA_COST_PUNTOS_VENTA="0.3"
# ARCA_COST_OTHER="1"
